allow hal_power_default sysfs_touchpanel:dir search;
allow hal_power_default sysfs_touchpanel:file rw_file_perms;

# Thermal
hal_client_domain(hal_power_default, hal_thermal)

# To do powerhint on nodes defined in powerhint.json
allow hal_power_default vendor_latency_device:chr_file rw_file_perms;

# Allow hal_power to access IStats AIDL
allow hal_power_default fwk_stats_service:service_manager find;
binder_call(hal_power_default, stats_service_server);
